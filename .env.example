# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# The scheduled tasks run in the web process, which holds the helper connection
SCHEDULER_HTTP_SERVER=true
LIMITER_STORE=database

# Helper: the path of its Unix socket, as the simulator prints it on start.
# On Windows, Node cannot reach a Unix socket: run the simulator with
# -tcp 127.0.0.1:7377 and use the value below.
HELPER_ADDRESS=tcp://127.0.0.1:7377
